# Copia este archivo como .env y rellena los valores.
# El archivo .env nunca debe subirse a git.

# Cuenta de Gmail que envía los correos de bienvenida
MAIL_USERNAME=cuenta@gmail.com
# Contraseña de aplicación de Google (no la contraseña normal de la cuenta), sin comillas
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Clave para firmar los tokens: Base64 de al menos 32 bytes.
# Generar una con: openssl rand -base64 32
JWT_SECRET=
